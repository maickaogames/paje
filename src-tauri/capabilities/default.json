{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permite que o Pajé publicado use os comandos nativos (áudio, PiP, atalhos e atualização).",
  "windows": ["main"],
  "remote": { "urls": ["https://paje.lovable.app/*"] },
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered"
  ]
}
